// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())

  // Player relation — user participates in many games
  playerGames Player[]

  // Messages they’ve sent
  messages Message[]

  // Games they created
  createdGames Game[] @relation("CreatedGames")
}

enum GameStatus {
  LOBBY
  ONGOING
  COMPLETED
  CANCELLED
}

model Game {
  id        String     @id @default(cuid())
  status    GameStatus @default(LOBBY)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  startedAt DateTime?
  endedAt   DateTime?

  // The player who created the game
  createdById String
  createdBy   User   @relation("CreatedGames", fields: [createdById], references: [clerkId])

  players       Player[]
  moves         Move[]
  chatMessages  Message[]
  boardState    Json?
  currentTurnId String?
}

model Player {
  id     String   @id @default(cuid())
  userId String
  gameId String
  score  Int      @default(0)
  tiles  String[] @default([])
  isHost Boolean  @default(false)
  createdAt DateTime @default(now()) // turn order

  user User @relation(fields: [userId], references: [clerkId])
  game Game @relation(fields: [gameId], references: [id])

  moves Move[]
}

model Move {
  id          String   @id @default(cuid())
  playerId    String
  gameId      String
  word        String?
  placedTiles Json?
  score       Int      @default(0)
  createdAt   DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])
  game   Game   @relation(fields: [gameId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [clerkId])
  game Game @relation(fields: [gameId], references: [id])
}
